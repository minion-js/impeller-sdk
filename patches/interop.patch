+static uint32_t CopyRects(const std::vector<ImpellerRect>& source,
+                          ImpellerRect* rects,
+                          uint32_t capacity) {
+  if (rects != nullptr) {
+    std::copy_n(source.begin(), std::min<size_t>(source.size(), capacity),
+                rects);
+  }
+  return static_cast<uint32_t>(source.size());
+}
+
+IMPELLER_EXTERN_C
+uint32_t ImpellerParagraphGetPlaceholderRects(ImpellerParagraph paragraph,
+                                              ImpellerRect* rects,
+                                              uint32_t capacity) {
+  return CopyRects(GetPeer(paragraph)->GetPlaceholderRects(), rects, capacity);
+}
