+                                           ImpellerRectWidthStyle width_style,
+                                           ImpellerRect* rects,
+                                           uint32_t capacity) {
+  return CopyRects(
+      GetPeer(paragraph)->GetRectsForRange(start, end, ToTxtType(height_style),
+                                           ToTxtType(width_style)),
